---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---

<Base title={site.pageTitle} description={site.pageDescription}>
  <!-- ============ 顶部导航 ============ -->
  <nav class="nav">
    <div class="wrap">
      <a class="brand" href="#top">{site.nav.brand}</a>
      <ul>
        {site.nav.links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- ============ 首屏：全屏大图，标题压在照片上 ============ -->
  <header class="hero" id="top">
    <img class="hero-bg" src={site.hero.cover.src} alt={site.hero.cover.alt} onerror="this.remove()" />
    <div class="hero-scrim"></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">{site.hero.eyebrow}</p>
      <h1 set:html={site.hero.title} />
      <p class="lead">{site.hero.lead}</p>
      <a class="btn" href={site.hero.buttonHref}>{site.hero.buttonLabel}</a>
    </div>
    <p class="hero-credit">{site.hero.coverNote}</p>
  </header>

  <!-- ============ 关于 ============ -->
  <section id="about">
    <div class="wrap">
      <div class="about">
        <div class="reveal">
          <p class="sec-title">{site.about.eyebrow}</p>
          <h2 class="sec-head" set:html={site.about.heading} />
          {site.about.paragraphs.map((text) => <p>{text}</p>)}
        </div>
        <div class="reveal">
          <ul class="facts">
            {site.about.facts.map((fact) => (
              <li><span>{fact.label}</span><span>{fact.value}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 照片 ============ -->
  <section id="photos" style="padding-top:0">
    <div class="wrap">
      <p class="sec-title">{site.photos.eyebrow}</p>
      <h2 class="sec-head">{site.photos.heading}</h2>

      <div class="grid">
        {site.photos.items.map((photo, i) => (
          <figure class="shot reveal" data-date={photo.date} id={`photo-${i}`}>
            <img
              src={photo.src}
              alt={photo.caption || photo.date}
              data-caption={photo.caption}
              data-date={photo.date}
              width={photo.w}
              height={photo.h}
              loading="lazy"
              decoding="async"
              onerror="this.remove()"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 右侧时间轴（液态玻璃，可拖动） ============ -->
  <div class="timeline" id="timeline">
    <div class="tl-track" id="tl-track">
      <div class="tl-ticks" id="tl-ticks"></div>
      <button class="tl-knob" id="tl-knob" type="button" aria-label="拖动查看拍摄时间">
        <span class="tl-date" id="tl-date"></span>
      </button>
    </div>
  </div>

  <!-- ============ 页脚 ============ -->
  <footer id="contact">
    <div class="wrap">
      <div class="foot">
        <div>
          <p style="margin:0 0 6px;color:var(--ink);font-weight:600">{site.footer.heading}</p>
          <p style="margin:0">
            写信给我：<a href={`mailto:${site.footer.email}`}>{site.footer.email}</a>
          </p>
        </div>
        <p style="margin:0">© <span id="year">2026</span> {site.footer.copyright}</p>
      </div>
    </div>
  </footer>

  <!-- ============ 底部悬浮计数（液态玻璃） ============ -->
  <div class="hits" id="hits">
    <span class="hits-dot"></span>
    <span>已被访问 <b id="busuanzi_value_site_pv">·</b> 次</span>
    <span class="hits-sep">·</span>
    <span><b id="busuanzi_value_site_uv">·</b> 位访客</span>
  </div>

  <!-- ============ 黑胶唱片：点一下展开播放器（唱针 + 进度环） ============ -->
  {site.music?.enabled && (
    <div class:list={['record', site.music.embed && 'has-embed']} id="record">
      {site.music.src && (
        <audio id="bgm" src={site.music.src} loop preload="none"></audio>
      )}

      {site.music.embed && (
        <div class="player-panel" id="player-panel" hidden>
          <iframe
            src={site.music.embed}
            allow="autoplay; encrypted-media"
            loading="lazy"
            title={site.music.title}
          ></iframe>
          {site.music.link && (
            <a href={site.music.link} target="_blank" rel="noopener noreferrer">
              {site.music.linkLabel || '在音乐平台打开'} ↗
            </a>
          )}
        </div>
      )}

      <span class="record-title">{site.music.title}</span>
      <button class="disc" id="disc" type="button" aria-label="播放背景音乐">
        <svg class="ring" viewBox="0 0 100 100" aria-hidden="true">
          <circle class="ring-bg" cx="50" cy="50" r="47"></circle>
          <circle class="ring-fg" id="ring" cx="50" cy="50" r="47"></circle>
        </svg>
        <span class="disc-face"></span>
        <span class="disc-hole"></span>
      </button>
      <span class="tonearm" aria-hidden="true"></span>
    </div>
  )}

  <!-- ============ 看大图的浮层 ============ -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button type="button" id="lb-close" aria-label="关闭">×</button>
    <img id="lb-img" src="" alt="" />
    <p class="lb-cap" id="lb-cap"></p>
  </div>

  <script>
    const lb = document.getElementById('lightbox')!;
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    const lbCap = document.getElementById('lb-cap')!;
    const lbClose = document.getElementById('lb-close')!;

    const open = (src: string, caption: string) => {
      lbImg.src = src;
      lbImg.alt = caption;
      lbCap.textContent = caption;
      lb.classList.add('open');
      document.body.classList.add('lb-open');
    };

    const close = () => {
      lb.classList.remove('open');
      document.body.classList.remove('lb-open');
    };

    document.querySelectorAll<HTMLImageElement>('.grid img').forEach((img) => {
      img.addEventListener('click', () => {
        const cap = img.dataset.caption || '';
        const date = (img.dataset.date || '').replace(/-/g, '.');
        open(img.src, [cap, date].filter(Boolean).join('　·　'));
      });
    });

    lbClose.addEventListener('click', close);
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  </script>

  <script>
    // 黑胶唱片：本地音频就地播；外部播放器则展开面板
    const record = document.getElementById('record');
    const disc = document.getElementById('disc') as HTMLButtonElement | null;
    const bgm = document.getElementById('bgm') as HTMLAudioElement | null;
    const ring = document.getElementById('ring') as SVGCircleElement | null;
    const panel = document.getElementById('player-panel') as HTMLDivElement | null;

    if (record && disc) {
      const setPlaying = (on: boolean) => {
        record.classList.toggle('playing', on);
        disc.setAttribute('aria-label', on ? '暂停音乐' : '播放音乐');
      };

      if (panel) {
        // 外部播放器模式：第一次展开时才加载 iframe
        disc.addEventListener('click', () => {
          const open = panel.hasAttribute('hidden');
          if (open) panel.removeAttribute('hidden');
          else panel.setAttribute('hidden', '');
          setPlaying(open);
        });

        document.addEventListener('click', (e) => {
          if (!record.contains(e.target as Node) && !panel.hasAttribute('hidden')) {
            panel.setAttribute('hidden', '');
            setPlaying(false);
          }
        });
      } else if (bgm) {
        const CIRC = 2 * Math.PI * 47;

        const paintRing = () => {
          if (!ring) return;
          const p = bgm.duration > 0 ? bgm.currentTime / bgm.duration : 0;
          ring.style.strokeDashoffset = String(CIRC * (1 - p));
        };

        disc.addEventListener('click', async () => {
          if (bgm.paused) {
            try {
              await bgm.play();
              setPlaying(true);
            } catch {
              const t = record.querySelector('.record-title');
              if (t) t.textContent = '音乐加载失败';
            }
          } else {
            bgm.pause();
            setPlaying(false);
          }
        });

        bgm.addEventListener('timeupdate', paintRing);
        bgm.addEventListener('loadedmetadata', paintRing);
        bgm.addEventListener('error', () => {
          const t = record.querySelector('.record-title');
          if (t) t.textContent = '还没有音乐文件';
        });
      }
    }
  </script>

  <script>
    // 右侧时间轴：刻度 = 每张照片，拖动 = 跳到那天
    const track = document.getElementById('tl-track') as HTMLDivElement | null;
    const ticks = document.getElementById('tl-ticks') as HTMLDivElement | null;
    const knob = document.getElementById('tl-knob') as HTMLButtonElement | null;
    const dateEl = document.getElementById('tl-date') as HTMLSpanElement | null;
    const figs = Array.from(document.querySelectorAll<HTMLElement>('.grid .shot'));

    if (track && ticks && knob && dateEl && figs.length > 1) {
      const times = figs.map((f) => new Date(`${f.dataset.date}T12:00:00`).getTime());
      const min = Math.min(...times);
      const max = Math.max(...times);
      const span = max - min || 1;
      const ratio = (t: number) => (t - min) / span;
      // 照片按时间倒序排时，时间轴顶端给最新的那张
      const descending = times[0] > times[times.length - 1];
      const posOf = (t: number) => (descending ? 1 - ratio(t) : ratio(t)) * 100;

      const fmt = (iso: string) => iso.slice(0, 7).replace('-', '.');

      figs.forEach((f, i) => {
        const tick = document.createElement('span');
        tick.className = 'tl-tick';
        tick.style.top = `${posOf(times[i])}%`;
        tick.title = f.dataset.date || '';
        tick.addEventListener('click', (e) => {
          e.stopPropagation();
          f.scrollIntoView({ behavior: 'smooth', block: 'center' });
        });
        ticks.appendChild(tick);
      });

      let active = -1;
      const setActive = (i: number) => {
        if (i < 0 || i === active) return;
        active = i;
        const top = Math.min(98, Math.max(2, posOf(times[i])));
        knob.style.top = `${top}%`;
        dateEl.textContent = fmt(figs[i].dataset.date || '');
      };

      const nearestToY = (clientY: number) => {
        const r = track.getBoundingClientRect();
        const f = Math.min(1, Math.max(0, (clientY - r.top) / r.height));
        let best = 0;
        let bestD = Infinity;
        times.forEach((t, i) => {
          const d = Math.abs(posOf(t) / 100 - f);
          if (d < bestD) {
            bestD = d;
            best = i;
          }
        });
        return best;
      };

      // 只找「最靠近视口中线」的那张；加一点回差，避免两张之间来回抖
      const nearestIndex = () => {
        const mid = window.innerHeight * 0.42;
        let best = 0;
        let bestD = Infinity;
        figs.forEach((f, i) => {
          const r = f.getBoundingClientRect();
          const d = Math.abs(r.top + r.height / 2 - mid);
          if (d < bestD) {
            bestD = d;
            best = i;
          }
        });
        return { best, bestD };
      };

      let rafPending = false;
      const syncFromScroll = () => {
        if (rafPending) return;
        rafPending = true;
        requestAnimationFrame(() => {
          rafPending = false;
          if (dragging) return;
          const { best } = nearestIndex();
          if (active >= 0 && best !== active) {
            // 新目标必须明显更近才切换，防止临界处反复横跳
            const cur = figs[active].getBoundingClientRect();
            const mid = window.innerHeight * 0.42;
            const dCur = Math.abs(cur.top + cur.height / 2 - mid);
            const cand = figs[best].getBoundingClientRect();
            const dNew = Math.abs(cand.top + cand.height / 2 - mid);
            if (dNew > dCur - 40) return;
          }
          setActive(best);
        });
      };

      window.addEventListener('scroll', syncFromScroll, { passive: true });
      syncFromScroll();

      let dragging = false;
      const jump = (clientY: number) => {
        const i = nearestToY(clientY);
        figs[i].scrollIntoView({ behavior: 'auto', block: 'center' });
        setActive(i);
      };

      knob.addEventListener('pointerdown', (e) => {
        dragging = true;
        track.classList.add('dragging');
        knob.setPointerCapture?.(e.pointerId);
        jump(e.clientY);
        e.preventDefault();
      });
      track.addEventListener('pointerdown', (e) => {
        if (e.target === knob) return;
        dragging = true;
        track.classList.add('dragging');
        jump(e.clientY);
        e.preventDefault();
      });
      window.addEventListener('pointermove', (e) => {
        if (dragging) jump(e.clientY);
      });
      window.addEventListener('pointerup', () => {
        dragging = false;
        track.classList.remove('dragging');
      });
      window.addEventListener('pointercancel', () => {
        dragging = false;
      });
    }
  </script>
</Base>
